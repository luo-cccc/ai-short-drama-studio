          "role": "director",
          "knowledge": "用动作揭示线索，保留发现与确认的先后关系。",
          "decision": "把当前节拍的发现完整呈现在一个镜头中。"
        },
        {
          "role": "camera",
          "knowledge": "中近景兼顾人物表情与手中线索。",
          "decision": "平视中近景，镜头随手部轻移，落在关键物上。"
        },
        {
          "role": "lighting",
          "knowledge": "光线变化不能替代可见叙事。",
          "decision": "入口柔光照亮面部与门闩，辅光维持暗部可读。"
        },
        {
          "role": "action",
          "knowledge": "手部接触物体前交代路径。",
          "decision": "先看向门闩，再把手移至目标附近。"
        },
        {
          "role": "staging",
          "knowledge": "固定入口与门闩的相对位置。",
          "decision": "人物位于门前，门闩始终在人物右前方。"
        },
        {
          "role": "dialogue",
          "knowledge": "台词承接可见发现。",
          "decision": "保留原句和说话顺序，动作停顿后开口。"
        },
        {
          "role": "sound",
          "knowledge": "动作音效与接触瞬间对应。",
          "decision": "持续铺设微弱院外风声，接触时出现轻响。"
        },
        {
          "role": "vfx",
          "knowledge": "实物线索不需要视觉特效。",
          "decision": "本镜不需要特效。"
        }
