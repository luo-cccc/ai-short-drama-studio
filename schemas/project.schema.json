{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-short-drama:project:1.1",
  "title": "AI短剧结构化项目",
  "description": "字段形状的唯一权威；跨实体关系、覆盖、台词、时长及依赖失效由 project_data.py 校验。",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": ["1.0", "1.1"]
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      },
      "minItems": 0
    },
    "scenes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scene"
      },
      "minItems": 1
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      },
      "minItems": 0
    },
    "beats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/beat"
      },
      "minItems": 1
    },
    "dialogues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dialogue"
      },
      "minItems": 0
    },
    "shots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot"
      },
      "minItems": 1
    },
    "voices": {
      "type": "array",
      "items": {"$ref": "#/$defs/voice"}
    },
    "prompts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prompt"
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "project",
    "characters",
    "scenes",
    "props",
    "beats",
    "dialogues",
    "shots",
    "prompts"
  ],
  "additionalProperties": false,
  "$defs": {
    "dependency": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:PRJ|CHAR|SCENE|PROP|BEAT|LINE|SHOT|PROMPT|VOICE)-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "id",
        "revision",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PRJ-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "aspect_ratio": {
          "enum": [
            "9:16",
            "16:9",
            "2.39:1"
          ]
        },
        "style": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "aspect_ratio",
        "style"
      ],
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHAR-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "voice": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "description",
        "voice"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SCENE-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "prop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PROP-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "beat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BEAT-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "scene_id": {
          "type": "string",
          "pattern": "^SCENE-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "summary": {
          "type": "string",
          "pattern": "\\S"
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHAR-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "prop_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PROP-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "scene_id",
        "summary",
        "character_ids",
        "prop_ids"
      ],
      "additionalProperties": false
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^LINE-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "beat_id": {
          "type": "string",
          "pattern": "^BEAT-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "speaker_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^CHAR-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "dialogue",
            "os",
            "narration"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "revision",
        "beat_id",
        "speaker_id",
        "kind",
        "text"
      ],
      "additionalProperties": false
    },
    "segment_line": {
      "type": "object",
      "properties": {
        "dialogue_id": {
          "type": "string",
          "pattern": "^LINE-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "start": {
          "type": "number",
          "description": "发声起点，使用所属 SHOT 的局部时间轴。",
          "minimum": 0,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "end": {
          "type": "number",
          "description": "发声终点，使用所属 SHOT 的局部时间轴，可延续至后续物理镜头。",
          "minimum": 0.1,
          "maximum": 30,
          "multipleOf": 0.1
        }
      },
      "required": [
        "dialogue_id",
        "text"
      ],
      "additionalProperties": false
    },
    "segment": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "end": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment_line"
          },
          "minItems": 0
        }
      },
      "required": [
        "index",
        "start",
        "end",
        "description",
        "lines"
      ],
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "role": {
          "enum": [
            "director",
            "camera",
            "lighting",
            "action",
            "staging",
            "dialogue",
            "sound",
            "vfx"
          ]
        },
        "knowledge": {
          "type": "string",
          "pattern": "\\S"
        },
        "decision": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "role",
        "knowledge",
        "decision"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "ambience": {
          "type": "string",
          "pattern": "\\S"
        },
        "music": {
          "type": "string",
          "pattern": "\\S"
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "ambience",
        "music",
        "effects"
      ],
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^SHOT-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SCENE-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "character_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CHAR-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "prop_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PROP-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "beat_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^BEAT-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "duration": {
          "type": "number",
          "minimum": 5,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/segment"
          },
          "minItems": 1
        },
        "static_prompt_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PROMPT-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dynamic_prompt_id": {
          "type": "string",
          "pattern": "^PROMPT-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "design": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/design"
          },
          "minItems": 8,
          "maxItems": 8
        },
        "audio": {
          "$ref": "#/$defs/audio"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "function": {
          "type": "string",
          "pattern": "\\S"
        },
        "transitions": {
          "type": "object",
          "properties": {
            "incoming": {
              "type": "string",
              "pattern": "\\S"
            },
            "outgoing": {
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": [
            "incoming",
            "outgoing"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "design_id": {
              "type": "string",
              "pattern": "^9B-[A-Za-z0-9_-]+$"
            },
            "status": {
              "enum": [
                "unreviewed",
                "needs_revision",
                "approved"
              ]
            }
          },
          "required": [
            "design_id",
            "status"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string"
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "revision",
        "title",
        "scene_ids",
        "character_ids",
        "prop_ids",
        "beat_ids",
        "duration",
        "segments",
        "static_prompt_ids",
        "dynamic_prompt_id",
        "design",
        "audio",
        "depends_on",
        "function",
        "transitions",
        "review",
        "notes"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "slot": {
          "type": "string",
          "pattern": "^@(?:素材|图片)[1-9][0-9]*$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^(?:CHAR|SCENE|PROP|PROMPT|VOICE)-[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "required": [
        "slot",
        "asset_id"
      ],
      "additionalProperties": false
    },
    "overlay": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "in_scene",
            "post_subtitle",
            "post_ui",
            "post_graphic"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "end": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "position": {
          "type": "string",
          "pattern": "\\S"
        },
        "method": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "text",
        "method"
      ],
      "additionalProperties": false
    },
    "prompt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PROMPT-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "template": {
          "enum": [
            "T1",
            "T2",
            "T3",
            "T4",
            "T5",
            "T6",
            "T6B",
            "T6C",
            "T7",
            "T8",
            "T9"
          ]
        },
        "shot_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^SHOT-[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "duration": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 5,
          "maximum": 30,
          "multipleOf": 0.1
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:CHAR|SCENE|PROP|VOICE)-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "reference_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "audio_reference_profile": {
          "$ref": "#/$defs/audio_reference_profile"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "revision",
        "template",
        "shot_id",
        "duration",
        "asset_ids",
        "reference_bindings",
        "text",
        "depends_on"
      ],
      "additionalProperties": false
    },
    "voice_reference": {
      "type": ["object", "null"],
      "properties": {
        "model_id": {"type": "string", "pattern": "\\S"},
        "path": {"type": "string", "pattern": "\\S"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "transcript": {"type": "string", "pattern": "\\S"}
      },
      "required": ["model_id", "path", "sha256", "duration", "transcript"],
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^VOICE-[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "revision": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "pattern": "\\S"},
        "character_id": {"type": ["string", "null"], "pattern": "^CHAR-[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "description": {"type": "string", "pattern": "\\S"},
        "language": {"type": "string", "pattern": "\\S"},
        "source": {"type": "string", "pattern": "\\S"},
        "status": {"enum": ["planned", "ready"]},
        "audition_text": {"type": "string", "pattern": "\\S"},
        "reference": {"$ref": "#/$defs/voice_reference"},
        "notes": {"type": "string"}
      },
      "required": ["id", "revision", "name", "character_id", "description", "language", "source", "status", "reference", "notes"],
      "additionalProperties": false
    },
    "audio_reference_profile": {
      "type": "object",
      "properties": {
        "model_id": {"type": "string", "pattern": "\\S"},
        "supports_voice_reference": {"type": "boolean"},
        "max_files": {"type": ["integer", "null"], "minimum": 0},
        "max_file_duration": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "max_total_duration": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "formats": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9]+$"}, "uniqueItems": true},
        "source": {"type": "string", "pattern": "\\S"}
      },
      "required": ["model_id", "supports_voice_reference", "max_files", "max_file_duration", "max_total_duration", "formats", "source"],
      "additionalProperties": false
    }
  }
}
